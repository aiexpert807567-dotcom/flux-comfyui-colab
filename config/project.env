# Project defaults. Environment variables set BEFORE running a script win over these.
# Put personal overrides (never secrets!) in config/local.env (git-ignored).

# Pinned ComfyUI release tag (https://github.com/Comfy-Org/ComfyUI/releases).
# Use "master" to track latest (less reproducible).
: "${COMFYUI_REF:=v0.35.0}"
: "${COMFYUI_REPO:=https://github.com/Comfy-Org/ComfyUI.git}"

# Storage: "none" = temporary Colab disk, "drive" = models+outputs on Google Drive.
# (Drive must be mounted from a notebook cell first; see colab/flux_comfyui.ipynb)
: "${PERSIST:=none}"
: "${DRIVE_ROOT:=/content/drive/MyDrive/flux-comfyui}"

# Model variant: auto | bf16 | fp8   (auto = chosen from detected GPU)
: "${FLUX_VARIANT:=auto}"

# Optional downloads: 1 = yes
: "${WITH_UPSCALER:=0}"

# Server
: "${COMFY_PORT:=8188}"
# Tunnel: cloudflared (public random URL, NO auth!) | none (localhost only)
: "${TUNNEL:=cloudflared}"
